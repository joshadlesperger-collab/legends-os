DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legends_os"
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
APP_URL="http://localhost:3000"
EBAY_CLIENT_ID="your-ebay-client-id"
EBAY_CLIENT_SECRET="your-ebay-client-secret"
EBAY_REDIRECT_URI_NAME="your-ebay-ru-name"
EBAY_MADN_ENDPOINT_URL="https://your-domain.example/api/ebay/account-deletion"
EBAY_MADN_VERIFICATION_TOKEN="your-ebay-madn-verification-token"
# Dedicated seller-offer canary gate. Leave empty until the exact displayed
# canary is separately approved; the only enabling value is documented in code.
EBAY_SELLER_OFFER_WRITES_ENABLED=""

# eBay Sandbox bidding configuration. Keep these separate from the Production
# EBAY_* values above and place real values only in the gitignored .env.local.
EBAY_SANDBOX_CLIENT_ID=""
EBAY_SANDBOX_CLIENT_SECRET=""
EBAY_SANDBOX_REDIRECT_URI_NAME=""
EBAY_SANDBOX_BUYER_USER_ID=""
EBAY_SANDBOX_BUYER_REFRESH_TOKEN=""
EBAY_SANDBOX_OAUTH_SCOPES="https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/buy.offer.auction"
EBAY_SANDBOX_MARKETPLACE_ID="EBAY_US"

CRON_SECRET="configure-a-strong-secret-in-vercel"
# Single-owner operator authentication. Use independent, high-entropy values.
OPERATOR_PASSWORD=""
OPERATOR_SESSION_SECRET=""
OPERATOR_ID="owner"
