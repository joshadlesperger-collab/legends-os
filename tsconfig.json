{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-batch-speed-validation/types/**/*.ts",
    ".next-bulk-approved/types/**/*.ts",
    ".next-bulk-grouped/types/**/*.ts",
    ".next-inventory-review-live/types/**/*.ts",
    ".next-inventory-review/types/**/*.ts",
    ".next-pricing-validated/types/**/*.ts",
    ".next-receipt-resolution/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "artifacts",
    "node_modules",
    "tests",
    ".next-backlog",
    ".next-speed-check",
    ".next-preparation-build",
    ".next-preparation-review",
    ".next-bulk-validation"
  ]
}
